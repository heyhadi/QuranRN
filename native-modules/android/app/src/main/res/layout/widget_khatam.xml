<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_khatam_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_emerald"
    android:padding="14dp">

    <!-- Header: Streak & Label -->
    <RelativeLayout
        android:id="@+id/khatam_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/khatam_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:background="@drawable/widget_badge_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="🔥 5 days"
            android:textColor="#E6C875"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/khatam_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="KHATAM GOAL"
            android:textColor="#A3C2B8"
            android:textSize="9sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Center: Pages Read & Progress bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_below="@id/khatam_header"
        android:layout_above="@+id/khatam_footer"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/khatam_pages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 / 4"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/khatam_pages_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="pages read today"
            android:textColor="#A3C2B8"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/khatam_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/widget_progress_track" />
    </LinearLayout>

    <!-- Footer: Days remaining & Branding -->
    <RelativeLayout
        android:id="@+id/khatam_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <TextView
            android:id="@+id/khatam_days_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="25 days remaining"
            android:textColor="#E6C875"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/khatam_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="وِرْد"
            android:textColor="#66B39E"
            android:textSize="12sp" />
    </RelativeLayout>
</RelativeLayout>
